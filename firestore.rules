rules_version = '2';

// ════════════════════════════════════════════════════════════════
//  Guiño guiño — reglas de seguridad de Firestore
//  Pega esto en: Firestore Database → Reglas → Publicar
//
//  ⚠️  Cambia PEGA_AQUI_TU_UID por el UID que te enseña admin.html
//      al entrar con Google. Mientras no lo cambies, nadie podrá
//      crear eventos (pero tampoco hay riesgo).
// ════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.uid in ['ILl8Hs7fdzfcHHlXtgzF8KyjyHu1']; }
    function eventPath(eid) { return /databases/$(database)/documents/events/$(eid); }
    function eventOpen(eid) {
      let e = get(eventPath(eid)).data;
      return e.active == true && request.time < e.endsAt;
    }
    function signalPath(eid, sid) { return /databases/$(database)/documents/events/$(eid)/signals/$(sid); }
    function matchPath(eid, mid)  { return /databases/$(database)/documents/events/$(eid)/matches/$(mid); }
    // ¿Existe un match entre a y b? (el id del match es "<uid1>_<uid2>" en orden alfabético)
    function isMatched(eid, a, b) { return exists(matchPath(eid, a + '_' + b)) || exists(matchPath(eid, b + '_' + a)); }
    // Match de grupo: el evento lo permite y la persona lo ha activado (dato privado en /optins).
    function groupsAllowed(eid) { let e = get(eventPath(eid)).data; return e.get('kind', 'boda') == 'fiesta' || e.get('groups', false) == true; }
    function optedIn(eid, u) { return get(/databases/$(database)/documents/events/$(eid)/optins/$(u)).data.get('group', false) == true; }
    // ¿Puedo ver si dos de mis matches (m[0] y m[1]) han hecho match entre ellos?
    // Solo si tengo match con los dos y los tres hemos activado el match de grupo.
    function groupView(eid, m) {
      return m.size() == 2 && groupsAllowed(eid)
        && isMatched(eid, request.auth.uid, m[0]) && isMatched(eid, request.auth.uid, m[1])
        && optedIn(eid, request.auth.uid) && optedIn(eid, m[0]) && optedIn(eid, m[1]);
    }

    match /events/{eid} {
      // Cualquiera con el enlace puede leer el nombre y la hora de fin;
      // solo tú puedes listar, crear, cerrar o borrar eventos.
      allow get: if signedIn();
      allow list, write: if isAdmin();

      // ── Fichas ──────────────────────────────────────────────
      match /profiles/{uid} {
        allow read: if isAdmin() || (signedIn() && eventOpen(eid));
        allow create, update: if signedIn() && request.auth.uid == uid && eventOpen(eid)
          && request.resource.data.keys().hasOnly(['name', 'gender', 'interest', 'selfie', 'side', 'updatedAt'])
          && request.resource.data.name is string     && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
          && request.resource.data.gender in ['mujer', 'hombre', 'otro']
          && request.resource.data.interest in ['mujeres', 'hombres', 'todos']
          && request.resource.data.selfie is string   && request.resource.data.selfie.size() < 150000
          && request.resource.data.selfie.matches('^data:image/jpeg;base64,.*')
          && (!('side' in request.resource.data) || request.resource.data.side in ['a', 'b', 'ambos']);
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }

      // ── Guiños (señales) ─────────────────────────────────────────────
      // Id = "<de>_<para>". La clave de la privacidad:
      // puedes ver una señal dirigida a ti SOLO si tú ya has mandado
      // la tuya a esa persona. Así nadie descubre quién le ha elegido
      // sin elegir también.
      match /signals/{sid} {
        allow create: if signedIn() && eventOpen(eid)
          && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to is string
          && request.resource.data.to != request.auth.uid
          && sid == request.auth.uid + '_' + request.resource.data.to
          && exists(/databases/$(database)/documents/events/$(eid)/profiles/$(request.auth.uid));
        allow get: if isAdmin() || (signedIn() && (
             resource.data.from == request.auth.uid
          || (resource.data.to == request.auth.uid
              && exists(signalPath(eid, request.auth.uid + '_' + resource.data.from)))));
        allow list: if isAdmin() || (signedIn() && resource.data.from == request.auth.uid);
        allow delete: if isAdmin() || (signedIn() && resource.data.from == request.auth.uid);
      }

      // ── Matches ─────────────────────────────────────────────
      // Solo se puede crear si existen las dos señales cruzadas.
      match /matches/{mid} {
        allow create: if signedIn() && eventOpen(eid)
          && request.resource.data.keys().hasOnly(['members', 'createdAt'])
          && request.resource.data.members.size() == 2
          && request.auth.uid in request.resource.data.members
          && mid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
          && exists(signalPath(eid, request.resource.data.members[0] + '_' + request.resource.data.members[1]))
          && exists(signalPath(eid, request.resource.data.members[1] + '_' + request.resource.data.members[0]));
        allow get: if isAdmin() || (signedIn()
          && (request.auth.uid in mid.split('_') || groupView(eid, mid.split('_'))));
        allow list: if isAdmin() || (signedIn() && request.auth.uid in resource.data.members);
        allow delete: if isAdmin();
      }

      // ── Instagram enviado a un match ────────────────────────
      // Id = "<de>_<para>". Solo se puede enviar a alguien con quien
      // tienes match, y solo lo leen quien lo envía y quien lo recibe.
      match /shares/{sid} {
        allow create, update: if signedIn() && eventOpen(eid)
          && request.resource.data.keys().hasOnly(['from', 'to', 'ig', 'createdAt'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to is string
          && sid == request.auth.uid + '_' + request.resource.data.to
          && request.resource.data.ig is string
          && request.resource.data.ig.matches('^[a-z0-9._]{1,30}$')
          && isMatched(eid, request.auth.uid, request.resource.data.to)
          && (resource == null || resource.data.from == request.auth.uid);
        allow get: if isAdmin() || (signedIn() && request.auth.uid in sid.split('_'));
        allow list: if isAdmin() || (signedIn()
          && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid));
        allow delete: if isAdmin() || (signedIn() && resource.data.from == request.auth.uid);
      }

      // ── Match de grupo (casilla voluntaria) ─────────────────
      // Privado: solo lo lee su dueño. Las reglas lo consultan por dentro.
      match /optins/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid && eventOpen(eid)
          && request.resource.data.keys().hasOnly(['group', 'updatedAt'])
          && request.resource.data.group is bool;
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }

      // ── Mensaje para los matches ────────────────────────────
      // Privado: SOLO lo puede leer su dueño y las personas con las que
      // tiene match. Ni siquiera el panel de administración lo lee
      // (solo puede borrarlo).
      match /contacts/{uid} {
        allow read: if signedIn() && eventOpen(eid)
          && (request.auth.uid == uid || isMatched(eid, request.auth.uid, uid));
        allow create, update: if signedIn() && request.auth.uid == uid && eventOpen(eid)
          && request.resource.data.keys().hasOnly(['message', 'updatedAt'])
          && request.resource.data.message is string && request.resource.data.message.size() <= 400;
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
    }
  }
}
